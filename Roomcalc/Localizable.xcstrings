        }
      }
    },
    "Extra part: the other leg of an L-shaped room or an alcove. Not covered: floor you won't cover, like kitchen cabinets.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ek bölüm: L şeklindeki odanın diğer kolu ya da bir girinti. Kaplanmayan alan: mutfak dolabı gibi kaplanmayacak zemin."
          }
        }
