    "Everything stays on this iPhone. No account, no ads, no tracking. Room scanning uses Apple RoomPlan and the LiDAR sensor; the camera image never leaves the phone.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her şey bu iPhone'da kalır. Hesap yok, reklam yok, takip yok. Oda tarama Apple RoomPlan ve LiDAR sensörünü kullanır; kamera görüntüsü telefondan çıkmaz."
          }
        }
      }
    },
    "Extra part": {
      "localizations": {
        "tr": {
          "stringUnit": {
